# menjalankan transcriber_service.py: mengambil job dari Redis (pipeline/job_queue.py) di container sendiri. Transkripsinya
# di Replicate, jadi tidak ada torch atau whisper di sini, hanya ringkasan lewat OpenAI dan penyimpanan hasil
FROM python:3.12-slim

# ffmpeg: ffprobe memetakan waktu audio ke waktu video (segments._to_container_time)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-transcriber.txt .
RUN pip install --no-cache-dir -r requirements-transcriber.txt

COPY pipeline/ pipeline/
COPY transcriber_service.py .

ENV PYTHONUNBUFFERED=1
CMD ["python", "transcriber_service.py"]
