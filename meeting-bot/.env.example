# Longest a single recording may run, in minutes. Empty or 0 = no cap: it then ends
# when the host ends the meeting, the bot is alone for EMPTY_MEETING_MINUTES (default
# 10, 0 = off), there is no audible sound for SILENCE_MINUTES (default 30, 0 = off),
# or someone presses Stop Rekam. A Free plan is still capped at 60.
MAX_RECORDING_DURATION_MINUTES=
RECORDINGS_DIR=recordings
# Path to the saved Google login session (see bots/google_login.py) that
# GoogleMeetBot loads into a fresh browser on every join — one file per
# Google account, so a second account just needs a different path here.
GOOGLE_AUTH_STATE_PATH=auth/google.json
# Signs the session cookie (pipeline/auth_store.py + /auth/* routes in
# app.py). Generate a real random value, e.g.: python -c "import secrets;
# print(secrets.token_hex(32))" — everyone gets logged out if this changes.
SECRET_KEY=
# tiny/base/small/medium/large-v3 — bigger is more accurate and slower.
# medium is a reasonable accuracy/CPU-speed tradeoff without a GPU; large-v3
# needs ~8-10GB RAM just to load and is impractical on CPU-only.
WHISPER_MODEL=medium
# Needed for AI Summarization (GPT-4o mini via the OpenAI API) — get one at
# https://platform.openai.com/api-keys. Not used by transcription, which runs
# locally.
OPENAI_API_KEY=
# Needed for speaker diarization (pyannote, via whisperx) — create a
# Read-Only token at https://huggingface.co/settings/tokens, and accept the
# terms on the pyannote/speaker-diarization-3.1 model page first.
HF_TOKEN=

# Postgres connection string for the meetings index (see
# pipeline/meetings_store.py). Using Supabase: Project Settings -> Database
# -> Connection string ("Transaction" pooler, port 5432 or 6543).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Xendit subscription billing (pipeline/xendit_client.py, app.py's
# /billing/* routes). Get the TEST secret key from the Xendit dashboard:
# Settings -> API Keys (use the test-mode key while developing).
XENDIT_SECRET_KEY=
# The static verification token you set in the Xendit dashboard under
# Settings -> Webhooks -> Callback/Verification Token. Must match exactly —
# /billing/webhook rejects any request whose x-callback-token header
# doesn't equal this.
XENDIT_WEBHOOK_TOKEN=
# A public HTTPS URL that reaches this backend — Xendit needs this both for
# the webhook (Settings -> Webhooks -> URL, append /billing/webhook) and for
# the checkout success/cancel redirect (Xendit rejects plain localhost
# there). A tunnel like ngrok works for local dev: `ngrok http 5050`, then
# copy the https://*.ngrok-free.app URL it prints.
PUBLIC_URL=
# Where the frontend dev server actually runs — /billing/return redirects
# here after bouncing through PUBLIC_URL. Always plain localhost; the
# browser doing the redirect is on this same machine either way.
LOCAL_FRONTEND_URL=http://localhost:8081

# Email sent to a meeting's owner once its transcript + summary are ready
# (pipeline/mailer.py). Optional — left blank, this feature just stays off,
# nothing else breaks. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER is your address, SMTP_PASSWORD is an App Password (Google
# Account -> Security -> 2-Step Verification -> App passwords), not your
# normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER if left blank.
SMTP_FROM=

# Cloudflare R2 (S3-compatible object storage, see pipeline/storage.py) —
# recordings/transcripts/summaries all live here, not on local disk. Create
# an Account API Token (not User) with Object Read & Write scoped to the
# bucket: dashboard -> R2 -> Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Docker-only: password for the redis service that queues a finished
# recording from a worker container to transcriber-1/transcriber-2 (see
# pipeline/job_queue.py, docker-compose.yml). Generate one with e.g.
# python -c "import secrets; print(secrets.token_urlsafe(24))" — required
# even though Redis is never exposed outside the compose network, in case a
# future port-mapping mistake ever exposes it. Not read outside Docker;
# running app.py bare-metal doesn't need this unless you also run Redis and
# a transcriber_service.py worker yourself.
REDIS_PASSWORD=
