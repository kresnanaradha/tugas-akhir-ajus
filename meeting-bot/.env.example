MAX_RECORDING_DURATION_MINUTES=5
RECORDINGS_DIR=recordings
GOOGLE_CHROME_CDP_URL=http://localhost:9222
# tiny/base/small/medium/large-v3 — bigger is more accurate and slower.
# medium is a reasonable accuracy/CPU-speed tradeoff without a GPU; large-v3
# needs ~8-10GB RAM just to load and is impractical on CPU-only.
WHISPER_MODEL=medium
# Needed for AI Summarization (GPT-4o mini via the OpenAI API) — get one at
# https://platform.openai.com/api-keys. Not used by transcription, which runs
# locally.
OPENAI_API_KEY=
# Needed for speaker diarization (pyannote, via whisperx) — create a
# Read-Only token at https://huggingface.co/settings/tokens, and accept the
# terms on the pyannote/speaker-diarization-3.1 model page first.
HF_TOKEN=

# Postgres connection string for the meetings index (see
# pipeline/meetings_store.py). Using Supabase: Project Settings -> Database
# -> Connection string ("Transaction" pooler, port 5432 or 6543).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Xendit subscription billing (pipeline/xendit_client.py, app.py's
# /billing/* routes). Get the TEST secret key from the Xendit dashboard:
# Settings -> API Keys (use the test-mode key while developing).
XENDIT_SECRET_KEY=
# The static verification token you set in the Xendit dashboard under
# Settings -> Webhooks -> Callback/Verification Token. Must match exactly —
# /billing/webhook rejects any request whose x-callback-token header
# doesn't equal this.
XENDIT_WEBHOOK_TOKEN=
# A public HTTPS URL that reaches this backend — Xendit needs this both for
# the webhook (Settings -> Webhooks -> URL, append /billing/webhook) and for
# the checkout success/cancel redirect (Xendit rejects plain localhost
# there). A tunnel like ngrok works for local dev: `ngrok http 5050`, then
# copy the https://*.ngrok-free.app URL it prints.
PUBLIC_URL=
# Where the frontend dev server actually runs — /billing/return redirects
# here after bouncing through PUBLIC_URL. Always plain localhost; the
# browser doing the redirect is on this same machine either way.
LOCAL_FRONTEND_URL=http://localhost:8081
