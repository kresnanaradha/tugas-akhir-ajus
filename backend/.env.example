# Batas lama satu rekaman, dalam menit. Kosong atau 0 = tanpa batas: rekaman berhenti saat host mengakhiri rapat,
# bot sendirian selama EMPTY_MEETING_MINUTES (default 10, 0 = mati), tidak ada suara selama SILENCE_MINUTES
# (default 30, 0 = mati), atau seseorang menekan Stop Rekam.
# Paket Free selalu punya batas atas 180 menit (billing_store.PLAN_LIMITS).
MAX_RECORDING_DURATION_MINUTES=
RECORDINGS_DIR=recordings

# Sesi login Google yang tersimpan (bots/google_login.py), dimuat GoogleMeetBot setiap join. Satu file per akun.
GOOGLE_AUTH_STATE_PATH=auth/google.json

# Menandatangani cookie sesi, semua orang logout kalau ini berubah. Buat dengan:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Nama dan istilah untuk deployment-mu: dipakai sebagai petunjuk untuk Whisper dan perbaikan transkrip, mis. EXTRA_VOCAB=Kresna, Diva
EXTRA_VOCAB=

# Transkripsi berjalan di Replicate (GPU berbayar per detik), audio rapat dikirim ke sana. Tidak ada transkripsi lokal:
# kalau tokennya kosong atau saldo habis, rapatnya gagal. Jaga saldo di atas US$5 supaya tidak kena batas 6 permintaan per menit.
# Token Replicate: replicate.com/account/api-tokens. Isi sendiri di file .env, jangan ditempel ke chat atau commit.
REPLICATE_API_TOKEN=
# Bahasa ucapan di Replicate (kode seperti id atau en), kosong = deteksi otomatis, yang bisa salah pada klip pendek
REPLICATE_LANGUAGE=id
# Model yang dipakai (Whisper large-v3-turbo + pyannote community-1, diarization dan timestamp per kata), dikunci ke satu
# versi supaya hasilnya tidak berubah diam-diam. Versi terbaru ada di replicate.com/thomasmol/whisper-diarization/versions
REPLICATE_MODEL=thomasmol/whisper-diarization:744c4f2bffae674f82e79ed46f9cc54796d4903b3e20e68353e05a93eb10a55c

# Kunci OpenAI untuk ringkasan, perbaikan transkrip, perbandingan, dan jawaban Knowledge Base (GPT-4o mini).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Postgres (Supabase: Project Settings -> Database -> Connection string, pooler di port 5432 atau 6543).
# Tabel dibuat otomatis saat koneksi pertama.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Billing Xendit. Pakai secret key TEST selama pengembangan (dashboard -> Settings -> API Keys).
XENDIT_SECRET_KEY=
# Token verifikasi dari Settings -> Webhooks, /billing/webhook menolak x-callback-token yang lain.
XENDIT_WEBHOOK_TOKEN=
# URL https publik yang menjangkau backend ini. Xendit butuh ini untuk webhook (url + /billing/webhook) dan untuk
# kembali dari checkout (localhost biasa ditolak). Untuk dev lokal: `ngrok http 5050` lalu salin url https-nya.
PUBLIC_URL=
# Tempat frontend berjalan, dipakai untuk redirect dan tautan di email.
LOCAL_FRONTEND_URL=http://localhost:8081

# Email (pipeline/mailer.py): ringkasan siap, reset password, undangan team, pemberitahuan rekaman tanpa AI. Opsional,
# kalau kosong tidak ada yang dikirim. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=alamatmu dan
# SMTP_PASSWORD berupa App Password (Akun Google -> Keamanan -> Verifikasi 2 Langkah -> Sandi aplikasi), bukan password login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# default ke SMTP_USER
SMTP_FROM=

# Cloudflare R2 (pipeline/storage.py): rekaman, transkrip, dan ringkasan disimpan di sini. Buat Account API Token
# (bukan User) dengan Object Read & Write di bucket: dashboard -> R2 -> Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Hanya untuk Docker: password service redis yang membawa rekaman selesai dari worker ke transkriber.
# Redis tidak pernah dibuka ke host, password ini untuk jaga-jaga kalau ada port yang terbuka karena salah konfigurasi.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# Opsional, hanya Docker. Join yang menunggu worker kosong lebih lama dari ini (detik) dibatalkan.
# JOIN_QUEUE_MAX_WAIT_SECONDS=600
